# Frontend-safe configuration only. Never place server secrets in VITE_* variables.
VITE_DATA_SOURCE=mock
# Optional: set e.g. 150 only when intentionally testing loading skeletons. Keep 0 for normal development.
VITE_MOCK_LATENCY_MS=0
VITE_API_BASE_URL=http://localhost:3000/api
VITE_MAP_TILE_URL=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png
VITE_MAP_PUBLIC_TOKEN=
