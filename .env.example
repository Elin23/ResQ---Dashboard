# ResQ Dashboard environment variables
#
# Vercel: add these under Project -> Settings -> Environment Variables,
# then redeploy. VITE_* values are compiled into the browser bundle and
# therefore must never contain secrets.

# The production/default data source.
VITE_DATA_SOURCE=api

# Production API URL. The backend MUST be reachable through HTTPS when the
# dashboard is deployed on Vercel (which serves the frontend over HTTPS).
VITE_API_BASE_URL=https://resqback.runasp.net

# Mock-only development latency.
VITE_MOCK_LATENCY_MS=0

# OpenStreetMap tile source used by the operational map.
VITE_MAP_TILE_URL=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png
VITE_MAP_PUBLIC_TOKEN=
